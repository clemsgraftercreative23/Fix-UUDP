<!--
    Evidence/bukti files here are served directly by IIS (no Laravel
    controller in front of them). Without this, the browser's
    preview-vs-download decision depends entirely on IIS's own default
    MIME map for the file's extension -- extensions like .jfif and .webp
    are frequently missing from an IIS default install, so the browser
    downloads them instead of previewing them, inconsistently with the
    .jpg/.png/.pdf files IIS already knows. Force a browser-safe
    Content-Type for every extension actually found in this folder (the
    <remove> before each <mimeMap add> avoids a duplicate-entry error for
    extensions IIS already maps globally), and ask for inline display.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".jpg" />
      <mimeMap fileExtension=".jpg" mimeType="image/jpeg" />
      <remove fileExtension=".jpeg" />
      <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
      <remove fileExtension=".jfif" />
      <mimeMap fileExtension=".jfif" mimeType="image/jpeg" />
      <remove fileExtension=".png" />
      <mimeMap fileExtension=".png" mimeType="image/png" />
      <remove fileExtension=".gif" />
      <mimeMap fileExtension=".gif" mimeType="image/gif" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".pdf" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="Content-Disposition" />
        <add name="Content-Disposition" value="inline" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
