# Google Gemini — Vision API (receipt/invoice OCR verification)
# Copy these into your real .env. See config/services.php.
#
# Used to OCR uploaded Travel/Entertainment receipt photos and cross-check
# the extracted "No. Invoice/Receipt" and amount against what the user
# typed. If GEMINI_API_KEY is left blank, the check is skipped (fails
# open) rather than blocking submissions.
#
# Get a key at https://aistudio.google.com/apikey (free tier available).

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.8-flash
